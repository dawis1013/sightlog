<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="450.0" prefWidth="400.0" spacing="15.0"
      style="-fx-background-color: #121214; -fx-border-color: #27272a; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="net.dawis.sightlog.gui.RegisterController">
    <padding>
        <Insets bottom="35.0" left="30.0" right="30.0" top="35.0"/>
    </padding>

    <HBox alignment="CENTER_RIGHT" prefWidth="400.0" spacing="5.0">
        <VBox.margin>
            <Insets right="-20.0" top="-25.0"/>
        </VBox.margin>
        <Button mnemonicParsing="false" onAction="#handleMinimizeWindow"
                style="-fx-background-color: transparent; -fx-text-fill: #71717a; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 4 8 4 8;"
                text="─"/>
        <Button mnemonicParsing="false" onAction="#handleCloseWindow"
                style="-fx-background-color: transparent; -fx-text-fill: #71717a; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 4 8 4 8;"
                text="✕"/>
    </HBox>

    <VBox alignment="CENTER" spacing="4.0">
        <Label text="CREATE ACCOUNT" textFill="#f4f4f5">
            <font>
                <Font name="System Bold" size="32.0"/>
            </font>
        </Label>
        <Label text="Join the SightLog community" textFill="#71717a">
            <font>
                <Font name="System Italic" size="13.0"/>
            </font>
        </Label>
    </VBox>

    <VBox maxWidth="310.0" spacing="6.0">
        <Label text="Username" textFill="#a1a1aa">
            <font>
                <Font name="System Bold" size="12.0"/>
            </font>
        </Label>
        <TextField fx:id="usernameField" promptText="Choose a username..."
                   style="-fx-background-color: #1e1e22; -fx-text-fill: #f4f4f5; -fx-prompt-text-fill: #52525b; -fx-border-color: #27272a; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;"/>
    </VBox>

    <VBox maxWidth="310.0" spacing="6.0">
        <Label text="Password" textFill="#a1a1aa">
            <font>
                <Font name="System Bold" size="12.0"/>
            </font>
        </Label>
        <PasswordField fx:id="passwordField" promptText="Create a password..."
                       style="-fx-background-color: #1e1e22; -fx-text-fill: #f4f4f5; -fx-prompt-text-fill: #52525b; -fx-border-color: #27272a; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;"/>
    </VBox>

    <Label fx:id="errorLabel" minHeight="20.0" textFill="#f87171" wrapText="true" alignment="CENTER"/>

    <HBox alignment="CENTER" maxWidth="310.0" spacing="12.0">
        <Button mnemonicParsing="false" onAction="#handleBackToLogin" prefWidth="150.0"
                style="-fx-background-color: transparent; -fx-text-fill: #a1a1aa; -fx-border-color: #27272a; -fx-border-width: 1; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;"
                text="Back to Login"/>
        <Button mnemonicParsing="false" onAction="#handleRegisterSubmit" prefWidth="150.0"
                style="-fx-background-color: #10b981; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 4; -fx-cursor: hand;"
                text="Sign Up"/>
    </HBox>

</VBox>